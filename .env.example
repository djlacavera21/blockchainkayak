# Demo is local, uses synthetic data, and creates a temporary manager access key.
LEDGER_MODE=demo
HOST=127.0.0.1
PORT=3000
DEMO_DB_PATH=./data/demo.sqlite
# For Fabric, set LEDGER_MODE=fabric and configure all of the following.
# Each configured token must be unique and at least 32 characters long.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# API_MANAGER_TOKEN=
# API_STAFF_TOKEN=
# API_AUDITOR_TOKEN=
# FABRIC_MSP_ID=Org1MSP
# FABRIC_CHANNEL=kayakchannel
# FABRIC_CHAINCODE=blockchainkayak
# FABRIC_PEER_ENDPOINT=localhost:7051
# FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
# FABRIC_TLS_CERT_PATH=/absolute/path/to/peer/tls/ca.crt
# FABRIC_IDENTITIES_PATH=./fabric-identities.json
# For a TLS reverse proxy, set the exact browser origin and HOST as needed.
# PUBLIC_ORIGIN=https://your-internal-kayak-app.example
